{
  "name": "plotlint-studio",
  "productName": "plotlint Studio",
  "version": "0.1.0",
  "description": "plotlint Studio as a desktop app",
  "private": true,
  "main": "main.cjs",
  "license": "AGPL-3.0-only",
  "author": "plotlint",
  "scripts": {
    "prepare-server": "node scripts/prepare-server.mjs",
    "start": "electron .",
    "test": "node --test \"test/*.test.cjs\"",
    "dist": "node scripts/prepare-server.mjs && electron-builder --win --publish never",
    "dist:dir": "node scripts/prepare-server.mjs && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.12"
  },
  "build": {
    "appId": "com.plotlint.studio",
    "productName": "plotlint Studio",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "main.cjs",
      "lib/**",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "plotlint-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "plotlint-Studio-${version}-portable.${ext}",
      "splashImage": "build-resources/portable-splash.bmp"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build-resources/icon.png"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
