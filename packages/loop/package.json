{
  "name": "@plotlint/loop",
  "version": "0.1.0",
  "description": "The closed loop for plotlint: author and editor agents, arbiter, stop conditions, held-out checks and the other Goodhart safeguards",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actalk/inkos-core": "workspace:*",
    "@plotlint/diagnostics": "workspace:*",
    "@plotlint/metrics": "workspace:*",
    "@plotlint/rules": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
