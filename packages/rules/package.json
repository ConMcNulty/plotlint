{
  "name": "@plotlint/rules",
  "version": "0.1.0",
  "description": "Deterministic rule engine for plotlint: rules over InkOS runtime story state that emit diagnostics",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "import": "./dist/eval/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "eval": "node eval/run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actalk/inkos-core": "workspace:*",
    "@plotlint/diagnostics": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
